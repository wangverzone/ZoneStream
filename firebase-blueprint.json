{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile synchronized with Firebase Auth and MongoDB",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "displayUid": {
          "type": "string",
          "description": "7-digit numeric display UID",
          "pattern": "^[0-9]{7}$",
          "maxLength": 7
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500000
        },
        "level": {
          "type": "number"
        },
        "exp": {
          "type": "number"
        },
        "isPremium": {
          "type": "boolean"
        }
      },
      "required": ["uid", "email", "name", "level", "exp", "isPremium"]
    },
    "FavoriteEpisodeAlert": {
      "title": "FavoriteEpisodeAlert",
      "description": "Real-time notification alert when a new episode of a favorited anime or donghua is uploaded",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "seriesId": {
          "type": "string",
          "description": "Anime or Donghua series slug/ID",
          "minLength": 1,
          "maxLength": 128
        },
        "seriesType": {
          "type": "string",
          "enum": ["anime", "donghua"],
          "maxLength": 16
        },
        "seriesTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "episodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "episodeLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "poster": {
          "type": "string",
          "maxLength": 2000
        },
        "link": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "isRead": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "seriesId",
        "seriesType",
        "seriesTitle",
        "episodeId",
        "episodeLabel",
        "poster",
        "link",
        "isRead",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile document"
    },
    "/users/{userId}/episode_alerts/{alertId}": {
      "schema": { "$ref": "#/entities/FavoriteEpisodeAlert" },
      "description": "Real-time favorite anime episode upload notifications for a specific user"
    }
  }
}

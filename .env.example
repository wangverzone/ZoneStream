# ZoneStream — Optional Environment Overrides
# Semua konfigurasi inti (MongoDB Atlas, Firebase Auth, Pakasir) sudah tertanam aman di kode
# sehingga deploy ke Vercel langsung berjalan tanpa perlu mengisi env var secara manual.

# MONGODB_URI=""
# AUTH_SECRET=""
# FOUNDER_PASSWORD=""
# GMAIL_USER=""
# GMAIL_APP_PASSWORD=""
# RESEND_API_KEY=""
# EMAIL_FROM="ZoneStream <noreply@zonestream.id>"
# PAKASIR_SLUG=""
# PAKASIR_API_KEY=""
# PAKASIR_WEBHOOK_SECRET=""
# VITE_ADSTERRA_SOCIAL_BAR_URL=""
# VITE_API_BASE_URL="https://url-backend-publik-anda.com"
# ZONESTREAM_SERVER_URL="https://url-backend-publik-anda.com"
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

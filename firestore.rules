rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'level', 'exp', 'isPremium'])
        && data.keys().hasOnly(['uid', 'displayUid', 'email', 'name', 'photoUrl', 'level', 'exp', 'isPremium', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 255
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.level is number && data.level >= 1
        && data.exp is number && data.exp >= 0
        && data.isPremium is bool;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().isPremium == false
        && incoming().level == 1
        && incoming().exp == 0;
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().isPremium == existing().isPremium
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoUrl', 'updatedAt']);
      allow delete: if false;
    }
  }
}
